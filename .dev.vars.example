# Copy this file to .dev.vars and fill in values for local development.
# These are secrets — never commit .dev.vars to git.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SHORTCUT_TOKEN=your_random_token_here
# Shared secret for /api/submit-track — chrisbuice.com sends this in
# X-Surfaces-Secret. Generate with: openssl rand -hex 32
SURFACES_SECRET=your_random_secret_here
NOTIFICATION_EMAIL=your_email_here
SPOTIFY_USER_ID=your_spotify_user_id
